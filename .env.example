# The demo needs none of this: Meta, Shopify and Bosta are answered by the
# made-up Velora world in src/demo. Copy to .env.local only for the offer email.
# .env.local is gitignored — never commit real tokens.

# ---------- Meta ----------
# Marketing API access token with ads_read on the ad account.
# Get one at developers.facebook.com > your app > Tools > Graph API Explorer,
# then extend it to a long-lived token (60 days) via the Access Token Debugger.
META_ACCESS_TOKEN=

# Already correct for this account — no "act_" prefix.
META_AD_ACCOUNT_ID=910000000000001

# Optional: limit every call to these campaigns (comma-separated).
# META_CAMPAIGN_IDS=  (demo uses its own campaigns)

# Bump when Meta deprecates the version (roughly every two years).
META_API_VERSION=v23.0

# ---------- Shopify ----------
# Admin API access token from a custom app.
# Shopify admin > Settings > Apps and sales channels > Develop apps >
# Create an app > Configure Admin API scopes > tick read_orders and
# read_products > Install > reveal the Admin API access token (shpat_...).
SHOPIFY_ADMIN_TOKEN=

SHOPIFY_STORE_DOMAIN=velora-demo.myshopify.com
SHOPIFY_API_VERSION=2025-10

# ---------- Bosta ----------
# The business API key from Bosta's dashboard (Settings > API). Used only for
# read/search calls in src/lib/bosta.ts — never to cancel, reroute, or edit a
# delivery. Powers the "Action Needed" tab.
BOSTA_API_KEY=

# ---------- Business ----------
# Failed COD deliveries as a share of gross sales. Shopify does not deduct
# these and records reversals weeks late, so the dashboard applies this rate
# instead of trusting recorded reversals.
# 0.1156 = a typical rate for COD cosmetics in Egypt. Use your own monthly rate.
RTO_RATE=0.1156

# ---------- Cloudflare Access (production only) ----------
# Leave REQUIRE_CF_ACCESS unset locally so `next dev` works without a tunnel.
# In production it is set to "true" in wrangler.jsonc and the Worker refuses
# any request without a valid Access assertion.
REQUIRE_CF_ACCESS=

# Your Cloudflare Zero Trust team domain, no scheme.
# Zero Trust dashboard > Settings > Custom Pages > team domain.
# Example: yourteam.cloudflareaccess.com
ACCESS_TEAM_DOMAIN=

# The Application Audience (AUD) tag for this specific Access application.
# Zero Trust > Access > Applications > your app > Overview > Application Audience.
ACCESS_AUD=

# The exact Google account allowed in. The Access policy allowlists this too;
# the Worker checks it again so a policy mistake alone is not enough to get in.
ALLOWED_EMAIL=

# ---------- Offer form email (optional) ----------
# Offers are always saved to D1 (table "offers"). Set these to also get an
# email for each one through a useSend server.
USESEND_URL=
USESEND_API_KEY=
OFFER_NOTIFY_TO=
OFFER_FROM=
